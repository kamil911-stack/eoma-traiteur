{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eoma-traiteur",
  "compatibility_date": "2026-07-08",
  "assets": {
    "directory": ".",
    // /mentions-legales sert mentions-legales.html sans rediriger.
    "html_handling": "auto-trailing-slash",
    // Les routes du routeur interne du bundle (/entreprises, /mariages,
    // /engagements, /la-cheffe, /galerie, /contact) n'ont pas de fichier
    // dedie : on renvoie index.html pour que la SPA affiche la bonne vue.
    // Sans ca, un rafraichissement sur ces URLs renvoyait vers l'accueil.
    "not_found_handling": "single-page-application"
  }
}
